				UNITY_TRANSFER_INSTANCE_ID(input, output);
				UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);

				float3 ase_positionWS = TransformObjectToWorld( ( input.positionOS ).xyz );
				float4 transform12 = mul(GetWorldToObjectMatrix(),float4( ase_positionWS , 0.0 ));
				float temp_output_22_0 = ( ( input.positionOS.xyz.y * cos( ( ( ( transform12.x + transform12.z ) * _WorldFreq ) + ( _TimeParameters.x ) ) ) ) * _Bentamount );
				float3 appendResult23 = (float3(temp_output_22_0 , 0.0 , temp_output_22_0));
				float3 rotatedValue30 = RotateAroundAxis( float3( 0,0,0 ), appendResult23, normalize( float3( 0,0,0 ) ), _Winddirection );
				
